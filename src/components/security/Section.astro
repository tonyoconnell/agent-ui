---
interface Props {
  title?: string
  sub?: string
  eyebrow?: string
  variant?: 'default' | 'fullbleed' | 'narrow' | 'centered'
  class?: string
}

const {
  title,
  sub,
  eyebrow,
  variant = 'default',
  class: className = '',
} = Astro.props

const hasHeading = Boolean(title || eyebrow)
const isCentered = variant === 'centered'

const sectionClasses = {
  default: 'mb-24',
  fullbleed: 'mb-24 -mx-6 px-6 py-20 bg-ridges border-y border-border',
  narrow: 'mb-24 max-w-2xl mx-auto px-6',
  centered: 'mb-24 text-center max-w-3xl mx-auto px-6',
}[variant]

const innerClasses = {
  default: 'max-w-4xl mx-auto px-6',
  fullbleed: 'max-w-5xl mx-auto',
  narrow: '',
  centered: '',
}[variant]
---

<section class:list={[sectionClasses, className]}>
  {innerClasses ? (
    <div class={innerClasses}>
      {hasHeading && (
        <div>
          {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
          {title && <h2 class="text-3xl font-bold tracking-tight mb-4">{title}</h2>}
          {sub && (
            <p class:list={['text-muted-foreground mb-8 max-w-xl leading-relaxed', isCentered && 'mx-auto']}>
              {sub}
            </p>
          )}
        </div>
      )}
      <slot />
    </div>
  ) : (
    <>
      {hasHeading && (
        <div>
          {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
          {title && <h2 class="text-3xl font-bold tracking-tight mb-4">{title}</h2>}
          {sub && (
            <p class:list={['text-muted-foreground mb-8 max-w-xl leading-relaxed', isCentered && 'mx-auto']}>
              {sub}
            </p>
          )}
        </div>
      )}
      <slot />
    </>
  )}
</section>
