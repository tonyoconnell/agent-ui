---
interface Props {
  endpoint?: string
  sdkLink?: string
  note?: string
}
const { endpoint, sdkLink = "/platform", note } = Astro.props
---
<div class="border-b border-tertiary-bright/30 bg-tertiary-bright/10 px-4 py-2.5 text-center text-xs text-tertiary-bright/90">
  <span class="font-mono text-tertiary-bright">◆ reference implementation</span>
  <span class="mx-2 text-tertiary-bright/50">·</span>
  <span>This page is built on the ONE backend.</span>
  {endpoint && (
    <>
      <span class="mx-2 text-tertiary-bright/50">·</span>
      <span>Underlying API: <code class="text-tertiary-bright/80">{endpoint}</code></span>
    </>
  )}
  {note && (
    <>
      <span class="mx-2 text-tertiary-bright/50">·</span>
      <span>{note}</span>
    </>
  )}
  <span class="mx-2 text-tertiary-bright/50">·</span>
  <a href={sdkLink} class="underline hover:text-tertiary-bright">Build your own →</a>
</div>
