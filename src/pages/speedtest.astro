---
import Layout from "@/layouts/Layout.astro"
import { SpeedtestDashboard } from "@/components/speedtest/SpeedtestDashboard"
---

<Layout title="Speed Benchmarks">
  <main class="min-h-screen bg-background p-8">
    <div class="max-w-6xl mx-auto">
      <SpeedtestDashboard client:load />
      <footer class="mt-8 text-xs text-muted-foreground text-center">
        See the full signal journey at <a class="text-primary-bright hover:underline" href="/speed">/speed</a>.
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  body {
    background: linear-gradient(135deg, hsl(var(--color-background)) 0%, hsl(var(--color-background)) 100%);
  }
</style>
