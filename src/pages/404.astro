---
/**
 * 404 — canonical not-found page
 *
 * Must exist as a static file to break the `[groupId]` catch-all redirect
 * loop: without this, unknown groups redirect to `/404`, which re-enters
 * `[groupId]/index.astro`, which redirects to `/404` again → ERR_TOO_MANY_REDIRECTS.
 *
 * Astro serves this for any unmatched route when `prerender = true` ships
 * a static 404.html alongside the SSR worker.
 */
import Layout from '@/layouts/Layout.astro'

export const prerender = true
---

<Layout title="Not found — ONE">
  <div class="min-h-screen bg-background text-font flex items-center justify-center px-6">
    <div class="max-w-md text-center">
      <p class="text-xs uppercase tracking-widest text-muted-foreground mb-4">404</p>
      <h1 class="text-3xl font-semibold mb-3">No path here.</h1>
      <p class="text-sm text-foreground/70 mb-8">
        The group, actor, or capability you asked for doesn't exist yet — or the pheromone faded. Follow a highway instead.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="rounded border border-[hsl(var(--color-primary-bright)/0.4)] bg-[hsl(var(--color-primary-bright)/0.1)] px-5 py-2 text-sm text-[hsl(var(--color-primary-bright)/0.8)] hover:bg-[hsl(var(--color-primary-bright)/0.2)] transition-colors">
          Home
        </a>
        <a href="/buy" class="rounded border border-border bg-card px-5 py-2 text-sm text-foreground hover:border-foreground/40 transition-colors">
          Marketplace
        </a>
        <a href="/world" class="rounded border border-border bg-card px-5 py-2 text-sm text-foreground hover:border-foreground/40 transition-colors">
          World map
        </a>
      </div>
    </div>
  </div>
</Layout>
