---
export const prerender = true
import Layout from "@/layouts/Layout.astro"
import { SecurityIcons, Fingerprint } from "@/components/icons/security"
import Section from "@/components/security/Section.astro"
import BrandTint from "@/components/security/BrandTint.astro"
import IconCard from "@/components/security/IconCard.astro"
import PullQuote from "@/components/security/PullQuote.astro"
import HeroVisual from "@/components/security/HeroVisual.astro"
import AuthorityChain from "@/components/security/AuthorityChain.astro"
import MockApprovalCard from "@/components/security/MockApprovalCard.tsx"
import {
  orgRows,
  howCards,
  trustStats,
  comparisonRows,
  authorityCards,
  zoneCards,
  hardQuestions,
} from "@/content/security"
---

<Layout
  title="ONE Security — Biometrics prove the human. Blockchain bounds the agent."
  description="For the first time, every digital action in your organisation traces back to a fingerprint. Not a password. Not a token. A human who was physically there."
>
  <main class="bg-ridges">
    <div class="mx-auto max-w-4xl px-6">

      <!-- HERO — asymmetric: visual left, copy right -->
      <section class="py-20 sm:py-28 grid sm:grid-cols-[auto_1fr] gap-12 items-center">
        <div class="hidden sm:block">
          <HeroVisual size={200} />
        </div>
        <div>
          <p class="eyebrow brand-primary mb-6">Security</p>
          <h1 class="text-5xl sm:text-7xl font-bold leading-[1.05] tracking-tight mb-7 text-foreground">
            Prove the human.<br />
            <span class="brand-primary">Then trust the agent.</span>
          </h1>
          <p class="text-xl text-muted-foreground max-w-xl leading-relaxed mb-10">
            For the first time, every digital action in your organisation traces back
            to a fingerprint on a chip — not a password, not a token, not a claim.
            A human who was physically there. That changes everything downstream.
          </p>
          <div class="flex gap-3 flex-wrap items-center">
            <a
              href="/u"
              class="inline-flex font-semibold px-7 py-3.5 rounded-lg transition-opacity hover:opacity-90 text-primary-foreground text-sm"
              style="background: hsl(var(--color-primary-bright));"
            >
              Open your wallet
            </a>
            <a
              href="/security/whitepaper"
              class="text-sm text-muted-foreground hover:text-foreground transition-colors underline underline-offset-4"
            >
              Technical whitepaper →
            </a>
          </div>
        </div>
      </section>

      <!-- TRUST STATS -->
      <section class="border-y border-border py-8 mb-20">
        <div class="grid sm:grid-cols-3 gap-6 sm:gap-0 sm:divide-x divide-border">
          {trustStats.map((stat) => {
            const Icon = SecurityIcons[stat.icon]
            return (
              <div class="flex items-center gap-4 sm:px-8 first:sm:pl-0 last:sm:pr-0 brand-primary">
                <div class="shrink-0"><Icon size={44} /></div>
                <div>
                  <p class="text-foreground font-semibold text-lg leading-tight">{stat.stat}</p>
                  <p class="text-muted-foreground text-sm leading-snug mt-0.5">{stat.sub}</p>
                </div>
              </div>
            )
          })}
        </div>
      </section>
    </div>

    <!-- PULL QUOTE 1 — chapter break -->
    <PullQuote quote="Identity is physics." family="primary" />

    <!-- THE SHIFT — fullbleed, contrasting backdrop -->
    <Section
      variant="fullbleed"
      title="Digital identity has been unsolved for fifty years."
      sub="Every system before biometrics is built on a claim. Claims can be wrong."
    >
      <div class="overflow-x-auto rounded-2xl border border-border bg-card mb-6">
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-border">
              <th class="px-6 py-4 eyebrow w-1/2">Old model — a claim</th>
              <th class="px-6 py-4 eyebrow eyebrow-brand brand-primary">With biometrics — a proof</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-b border-border last:border-0">
                <td class="px-6 py-4 text-muted-foreground">{row.old}</td>
                <td class="px-6 py-4 text-foreground">{row.next}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border border-border rounded-2xl p-6 bg-card">
          <p class="eyebrow mb-3">The old model</p>
          <p class="text-muted-foreground leading-relaxed text-sm">
            A password says "someone who knows this string is authorised."
            A token says "someone who possesses this credential is authorised."
            Both are claims. Claims transfer. Claims get stolen.
          </p>
        </div>
        <BrandTint family="primary" class="rounded-2xl p-6">
          <p class="eyebrow eyebrow-brand mb-3">The new model</p>
          <p class="text-muted-foreground leading-relaxed text-sm">
            Touch ID on Apple's Secure Enclave says: <strong class="text-foreground">"the person whose fingerprint is enrolled on this chip was physically present."</strong>
            That cannot be delegated, forwarded, or stolen. The only way to produce it is to be there.
          </p>
        </BrandTint>
      </div>
    </Section>

    <div class="mx-auto max-w-4xl px-6">

      <!-- FOR YOUR ORGANISATION -->
      <Section
        title="What this means for your organisation."
        sub="From legal standing to treasury — the implications are specific."
      >
        <div class="space-y-2">
          {orgRows.map((row) => {
            const Icon = SecurityIcons[row.icon]
            return (
              <BrandTint family={row.family} as="details" class="group rounded-2xl overflow-hidden">
                <summary class="px-6 py-5 cursor-pointer list-none flex items-center gap-5">
                  <div class="shrink-0"><Icon size={44} /></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-foreground font-semibold">{row.title}</p>
                    <p class="text-muted-foreground text-sm mt-0.5 leading-snug">{row.lead}</p>
                  </div>
                  <span class="text-muted-foreground text-xl shrink-0 group-open:rotate-45 transition-transform duration-200 leading-none mr-1">+</span>
                </summary>
                <p class="px-6 pb-6 text-muted-foreground text-sm leading-relaxed border-t border-border pt-5 ml-[68px]">
                  {row.body}
                </p>
              </BrandTint>
            )
          })}
        </div>
      </Section>

      <!-- AUTHORITY CHAIN — asymmetric: diagram left, Q&A cards right -->
      <Section
        title="Every agent action traces back to a human who was there."
        sub="When you give an AI agent a spending limit, you are signing a bounded power of attorney with your biometric. The blockchain records it. A Move smart contract enforces it. The agent cannot exceed it — regardless of what its model tells it to do."
      >
        <div class="grid lg:grid-cols-[3fr_2fr] gap-8 items-start">
          <AuthorityChain />
          <div class="space-y-3">
            {authorityCards.map((card) => (
              <BrandTint family={card.family} class="rounded-xl p-5">
                <p class="eyebrow eyebrow-brand mb-2">{card.head}</p>
                <p class="text-foreground text-sm font-medium mb-2">"{card.q}"</p>
                <p class="text-muted-foreground text-sm leading-relaxed">{card.a}</p>
              </BrandTint>
            ))}
          </div>
        </div>
      </Section>

      <!-- AGENT AUTONOMY — zone cards + LIVE mock approval card -->
      <Section>
        <h2 class="text-3xl font-bold mb-3 text-foreground">
          Agents run autonomously.<br />
          <span class="brand-primary">Exceptions need a fingerprint.</span>
        </h2>
        <p class="text-muted-foreground mb-10 max-w-xl leading-relaxed">
          You set the rules once with Touch ID. Your agent operates freely inside them.
          When it needs to go further, it shows you exactly what it wants to do —
          and you sign exactly that transaction. Nothing else.
        </p>

        <div class="grid sm:grid-cols-3 gap-3 mb-10">
          {zoneCards.map((zone) => (
            <BrandTint family={zone.family} class="rounded-xl p-5">
              <p class="eyebrow eyebrow-brand mb-2">{zone.label}</p>
              <p class="text-foreground text-sm font-medium mb-3">{zone.bullet}</p>
              <ul class="space-y-1.5">
                {zone.items.map((item) => (
                  <li class="text-muted-foreground text-sm flex items-start gap-2">
                    <span class="shrink-0 mt-0.5" style={`color: hsl(var(--color-${zone.family}-bright));`}>›</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </BrandTint>
          ))}
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-start">
          <MockApprovalCard client:visible />
          <div class="space-y-7">
            <div class="flex items-start gap-4 brand-primary">
              <div class="shrink-0"><SecurityIcons.approve size={44} /></div>
              <div>
                <h3 class="font-semibold text-foreground mb-1.5">You sign the transaction, not a permission</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  The agent builds the full transaction before asking. What you see on the card
                  is what executes. When you Touch ID, the Secure Enclave signs that specific
                  transaction — not a vague intent. It cannot change after submission.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 brand-primary">
              <div class="shrink-0"><Fingerprint size={44} /></div>
              <div>
                <h3 class="font-semibold text-foreground mb-1.5">One gesture. Irreversible record.</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  Touch ID → transaction submitted → on-chain digest recorded. The blockchain
                  entry is the audit trail: agent, request ID, digest, timestamp, biometric proof.
                  No second screen. No ambiguity.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 brand-secondary">
              <div class="shrink-0"><SecurityIcons.power size={44} /></div>
              <div>
                <h3 class="font-semibold text-foreground mb-1.5">Reject or ignore — nothing happens</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  Reject sends the agent a dissolved signal. Ignore lets the request expire.
                  Either way, nothing executes. The default is always no.
                  A compromised notification system cannot trick you into approving by silence.
                </p>
              </div>
            </div>
          </div>
        </div>
      </Section>

      <!-- HOW IT WORKS — 4 cards, 2x2 -->
      <Section
        title="The mechanism, briefly."
        sub="Four components. Each one is why the others work."
      >
        <p class="text-muted-foreground -mt-6 mb-8 max-w-xl text-sm">
          Full detail in the <a href="/security/whitepaper" class="text-foreground underline underline-offset-2 hover:opacity-80 transition-opacity">whitepaper</a>.
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          {howCards.map((card) => (
            <IconCard
              family={card.family}
              iconName={card.icon}
              eyebrow={card.label}
              step={card.step}
              body={card.text}
            />
          ))}
        </div>
      </Section>
    </div>

    <!-- PULL QUOTE 2 — thesis chapter break -->
    <PullQuote
      quote="Biometrics prove the human. Blockchain bounds the agent. Everything else is math."
      family="primary"
    />

    <!-- HARD QUESTIONS — narrow editorial -->
    <Section variant="narrow" title="The hard questions.">
      <div class="space-y-2">
        {hardQuestions.map((qa) => (
          <details class="border border-border rounded-xl bg-card group">
            <summary class="px-6 py-5 cursor-pointer text-foreground font-medium list-none flex items-center justify-between gap-4">
              <span>{qa.q}</span>
              <span class="text-muted-foreground text-xl shrink-0 group-open:rotate-45 transition-transform duration-200 leading-none">+</span>
            </summary>
            <p class="px-6 pb-6 text-muted-foreground text-sm leading-relaxed border-t border-border pt-4">
              {qa.a}
            </p>
          </details>
        ))}
      </div>
    </Section>

    <!-- TIERED CTA — three audiences, three doors -->
    <Section variant="centered" class="border-t border-border pt-20">
      <div class="flex justify-center mb-10">
        <HeroVisual size={140} />
      </div>

      <p class="eyebrow mb-5">
        Biometrics prove the human · Blockchain bounds the agent · Everything else is math
      </p>

      <h2 class="text-5xl sm:text-6xl font-bold tracking-tight mb-4 text-foreground">
        Tap once.
      </h2>
      <p class="text-2xl text-muted-foreground font-medium mb-12">
        Your wallet is already here.
      </p>

      <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto text-left">
        <BrandTint family="primary" class="rounded-xl p-5">
          <p class="eyebrow eyebrow-brand mb-2">Individuals</p>
          <p class="text-foreground font-semibold mb-1">Open your wallet</p>
          <p class="text-muted-foreground text-sm leading-snug mb-4">No signup. No email. Touch ID to keep it.</p>
          <a
            href="/u"
            class="inline-flex font-semibold px-5 py-2.5 rounded-lg text-primary-foreground text-sm w-full justify-center transition-opacity hover:opacity-90"
            style="background: hsl(var(--color-primary-bright));"
          >
            Open wallet →
          </a>
        </BrandTint>

        <BrandTint family="secondary" class="rounded-xl p-5">
          <p class="eyebrow eyebrow-brand mb-2">Enterprise</p>
          <p class="text-foreground font-semibold mb-1">Talk to security</p>
          <p class="text-muted-foreground text-sm leading-snug mb-4">SOC 2, jurisdictional review, multi-sig deployment.</p>
          <a
            href="mailto:security@one.ie"
            class="inline-flex font-semibold px-5 py-2.5 rounded-lg text-foreground text-sm w-full justify-center border border-border transition-colors hover:bg-muted"
          >
            Contact us →
          </a>
        </BrandTint>

        <BrandTint family="tertiary" class="rounded-xl p-5">
          <p class="eyebrow eyebrow-brand mb-2">Engineering</p>
          <p class="text-foreground font-semibold mb-1">Read the whitepaper</p>
          <p class="text-muted-foreground text-sm leading-snug mb-4">Threat model, key derivation, Move contracts.</p>
          <a
            href="/security/whitepaper"
            class="inline-flex font-semibold px-5 py-2.5 rounded-lg text-foreground text-sm w-full justify-center border border-border transition-colors hover:bg-muted"
          >
            Whitepaper →
          </a>
        </BrandTint>
      </div>

      <div class="flex justify-center gap-6 mt-12 eyebrow">
        <a href="/platform" class="hover:text-foreground transition-colors">Enterprise</a>
        <span>·</span>
        <a href="/build" class="hover:text-foreground transition-colors">Deploy an agent</a>
        <span>·</span>
        <span>security@one.ie</span>
      </div>
    </Section>

  </main>
</Layout>
