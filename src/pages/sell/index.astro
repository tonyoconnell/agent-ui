---
/**
 * /sell — My capability listings
 *
 * SSR shell. SellListIsland hydrates client-side with the user's skills.
 */
import Layout from '@/layouts/Layout.astro'
import { SellListIsland } from '@/components/sell/SellListIsland'

export const prerender = false
---

<Layout title="My Listings — ONE">
  <div class="min-h-screen bg-background text-font">

    <!-- Header bar -->
    <div class="border-b border-border bg-card px-6 py-6">
      <div class="mx-auto flex max-w-5xl items-center justify-between">
        <div>
          <nav class="mb-1 text-xs text-muted-foreground">
            <a href="/" class="hover:text-foreground">Home</a>
            <span class="mx-1">/</span>
            <span class="text-foreground">Sell</span>
          </nav>
          <h1 class="text-xl font-semibold">My Listings</h1>
          <p class="mt-1 text-xs text-muted-foreground">Published skills buyers can discover and hire.</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/buy" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
            Buy →
          </a>
          <a
            href="/sell/new"
            class="rounded-md bg-[hsl(var(--color-primary-bright))] px-4 py-2 text-sm font-medium text-background transition-colors hover:bg-[hsl(var(--color-primary-bright)/0.8)]"
          >
            + New listing
          </a>
        </div>
      </div>
    </div>

    <!-- Island -->
    <div class="mx-auto max-w-5xl px-6 py-8">
      <SellListIsland client:load />
    </div>

  </div>
</Layout>
