---
import Layout from '@/layouts/Layout.astro'
import { OrgChartView } from '@/components/org/OrgChartView'

export const prerender = false
---

<Layout
  title="Service · Org · ONE"
  description="The CXO and the team that keeps every customer alive — onboarding, support, incidents and success."
>
  <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:py-14">
    <header class="mb-8">
      <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-muted-foreground mb-2">
        Org · Service
      </p>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight">
        Onboard. Resolve. Retain.
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl">
        The CXO owns the four customer moments — onboarding, friction, incident and breakup.
        First response under two hours; first loop closed for ninety percent.
      </p>
      <nav class="mt-5 flex flex-wrap gap-2 text-xs">
        <a href="/org" class="px-3 py-1.5 rounded-full border border-foreground/15 hover:border-foreground/40 transition-colors">Complete</a>
        <a href="/org/marketing" class="px-3 py-1.5 rounded-full border border-foreground/15 hover:border-foreground/40 transition-colors">Marketing</a>
        <a href="/org/sales" class="px-3 py-1.5 rounded-full border border-foreground/15 hover:border-foreground/40 transition-colors">Sales</a>
        <a href="/org/service" class="px-3 py-1.5 rounded-full border border-foreground/30 bg-foreground/5">Service</a>
      </nav>
    </header>

    <div style="height: min(78vh, 820px);">
      <OrgChartView chart="service" client:only="react" />
    </div>
  </main>
</Layout>
